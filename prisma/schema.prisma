generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PackageTier {
  ESSENTIAL
  CLASSIC
  SIGNATURE
  BESPOKE
}

enum EnquiryKind {
  VIEWING
  PROPOSAL
}

enum EnquiryStatus {
  NEW
  ASSIGNED
  CONTACTED
  CLOSED
}

model Account {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  status       AccountStatus @default(ACTIVE)
  roles        AccountRole[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  assignedEnquiries Enquiry[]  @relation("AssignedEnquiries")
  auditEntries   AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Role {
  id          String        @id @default(cuid())
  key         String        @unique
  label       String
  permissions String[]
  accounts    AccountRole[]
}

model AccountRole {
  accountId String
  roleId    String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountId, roleId])
}

model ContentPage {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  body            Json?
  seoTitle        String?
  seoDescription  String?
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model EventType {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enquiries   Enquiry[]
}

model Package {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tier        PackageTier
  tagline     String?
  description String?
  priceCents  Int?
  currency    String        @default("GBP")
  inclusions  Json?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enquiries   Enquiry[]
}

model GalleryAlbum {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  images      GalleryImage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GalleryImage {
  id        String        @id @default(cuid())
  albumId   String?
  album     GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  key       String
  caption   String?
  alt       String?
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Testimonial {
  id        String        @id @default(cuid())
  name      String
  quote     String
  eventType String?
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String?
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Enquiry {
  id           String        @id @default(cuid())
  kind         EnquiryKind
  name         String
  email        String
  phone        String?
  message      String?
  eventDate    DateTime?
  eventTypeId  String?
  eventType    EventType?    @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  packageId    String?
  package      Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status       EnquiryStatus @default(NEW)
  assignedToId String?
  assignedTo   Account?      @relation("AssignedEnquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model FileAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model NotificationOutbox {
  id            String       @id @default(cuid())
  type          String
  to            String
  subject       String
  text          String
  html          String?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}
