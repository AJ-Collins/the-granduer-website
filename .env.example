# Local dev (docker-compose.yml maps postgres to 5433; a system postgres may own 5432)
DATABASE_URL=postgresql://dgrandeur:dgrandeur@localhost:5433/dgrandeur
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me-to-32-plus-random-chars-in-production

# Surfaces (dev defaults mirror admin.localhost / cms.localhost; any port)
APEX_DOMAIN=localhost
# ADMIN_HOST=admin.localhost
# CMS_HOST=cms.localhost

# Storage (local disk by default; set minio + MINIO_* for S3-compatible)
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=dgrandeur
# MINIO_USE_SSL=false

# Email (logged, not sent, when unset)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=noreply@dgrandeur.com
